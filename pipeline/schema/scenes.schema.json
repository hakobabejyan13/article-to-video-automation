{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenes.schema.json",
  "title": "Scenes JSON (PLAN.md section 3)",
  "description": "Written by the scenes stage. Every fact-bearing element carries its own source_ids (sentence numbers from scenes/<id>.sentences.json). Cited text is never stored here; the checker and fact sheet look it up.",
  "type": "object",
  "additionalProperties": false,
  "required": ["article", "scenes"],
  "properties": {
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "promotional"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1, "description": "Copied from the front matter, never chosen by the LLM"},
        "promotional": {"type": "boolean", "description": "Copied from the front matter"}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "source_ids": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "uniqueItems": true
    },
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "voiceover_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_ids"],
      "properties": {
        "text": {"$ref": "#/$defs/text"},
        "source_ids": {"$ref": "#/$defs/source_ids"},
        "spoken": {"type": ["string", "null"], "description": "Filled by the tts stage from the lexicon"}
      }
    },
    "on_screen_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "text", "source_ids"],
      "properties": {
        "role": {"enum": ["headline", "sub", "bullet", "quote"]},
        "text": {"$ref": "#/$defs/text"},
        "source_ids": {"$ref": "#/$defs/source_ids", "description": "Empty for text that makes no claim; such text may not contain numbers"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "source_ids"],
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "value": {"$ref": "#/$defs/text"},
        "source_ids": {"allOf": [{"$ref": "#/$defs/source_ids"}, {"minItems": 1}]}
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["card", "big_number", "bar_chart", "price_cards", "bullets", "quote"]},
        "variant": {"enum": ["title", "disclosure", "outro"]},
        "icon": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "A Lucide icon name; generic symbols only"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "card"}}},
          "then": {"required": ["variant"]},
          "else": {"not": {"required": ["variant"]}}
        },
        {
          "if": {"properties": {"type": {"const": "big_number"}}},
          "then": {"required": ["items"], "properties": {"items": {"minItems": 1, "maxItems": 3}}}
        },
        {
          "if": {"properties": {"type": {"const": "bar_chart"}}},
          "then": {"required": ["items"], "properties": {"items": {"minItems": 2, "maxItems": 10}}}
        },
        {
          "if": {"properties": {"type": {"const": "price_cards"}}},
          "then": {"required": ["items"], "properties": {"items": {"minItems": 1, "maxItems": 4}}}
        },
        {
          "if": {"properties": {"type": {"enum": ["card", "bullets", "quote"]}}},
          "then": {"properties": {"items": {"maxItems": 0}}}
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim_owner", "visual", "on_screen", "voiceover"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "claim_owner": {"type": "string", "pattern": "^(publisher|none|company:\\S.*)$"},
        "visual": {"$ref": "#/$defs/visual"},
        "on_screen": {"type": "array", "items": {"$ref": "#/$defs/on_screen_text"}},
        "voiceover": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/voiceover_line"}},
        "duration_s": {"type": ["number", "null"], "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"visual": {"properties": {"type": {"const": "bullets"}}}}},
          "then": {"properties": {"on_screen": {"contains": {"properties": {"role": {"const": "bullet"}}}, "minContains": 2}}}
        },
        {
          "if": {"properties": {"visual": {"properties": {"type": {"const": "quote"}}}}},
          "then": {"properties": {"on_screen": {"contains": {"properties": {"role": {"const": "quote"}}}, "minContains": 1, "maxContains": 1}}}
        }
      ]
    }
  }
}
