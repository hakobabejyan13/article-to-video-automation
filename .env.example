# Copy this file to .env in the project folder and fill in the keys.
# .env is git-ignored and must never be shared or committed.
# Leave a key empty in the cloud, where the network adds it.

# Default LLM (llm.api_key_env in pipeline/config.yaml)
GEMINI_API_KEY=

# Paid fallback, only if llm.provider is set to anthropic
ANTHROPIC_API_KEY=
